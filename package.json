{
  "name": "ko-speechlevel",
  "version": "0.1.1",
  "description": "Deterministic Korean speech-level (honorific) consistency checker for LLM output: flags sentences that slip from polite to casual, with offsets. Library, CLI, promptfoo assertion, vitest matcher, streaming checker.",
  "keywords": ["korean", "speech-level", "honorific", "llm", "evaluation", "promptfoo", "vitest", "assertion", "lint"],
  "license": "MIT",
  "author": "LeeGyeongPil",
  "repository": { "type": "git", "url": "git+https://github.com/LeeGyeongPil/ko-speechlevel.git" },
  "homepage": "https://github.com/LeeGyeongPil/ko-speechlevel#readme",
  "bugs": { "url": "https://github.com/LeeGyeongPil/ko-speechlevel/issues" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./promptfoo": { "types": "./dist/adapters/promptfoo.d.mts", "default": "./dist/adapters/promptfoo.mjs" },
    "./vitest": { "types": "./dist/adapters/vitest.d.ts", "default": "./dist/adapters/vitest.js" },
    "./package.json": "./package.json"
  },
  "bin": { "ko-speechlevel": "./dist/cli.js" },
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "sideEffects": ["./dist/adapters/vitest.js"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "vitest run",
    "start": "npm run build && node dist/cli.js check examples/answers/polite.md examples/answers/mixed.md examples/answers/quoted-source.md --expect polite --exit-zero",
    "check:pack": "npm run build && node scripts/check-pack.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run check:pack"
  },
  "peerDependencies": { "vitest": ">=5" },
  "peerDependenciesMeta": { "vitest": { "optional": true } },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
